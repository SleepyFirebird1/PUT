(define (problem hanoip)
    (:domain hanoi)
    (:objects k1 k2 k3 k4 k5 - krazek)
    (:init
        (x_wiekszy_y k5 k4)
        (x_wiekszy_y k5 k3)
        (x_wiekszy_y k5 k2)
        (x_wiekszy_y k5 k1)
        (x_wiekszy_y k4 k3)
        (x_wiekszy_y k4 k2)
        (x_wiekszy_y k4 k1)
        (x_wiekszy_y k3 k2)
        (x_wiekszy_y k3 k1)
        (x_wiekszy_y k2 k1)
        
        (na_paliku k1 x)
        (na_paliku k2 x)
        (na_paliku k3 x)
        (na_paliku k4 x)
        (na_paliku k5 x)
    )
    (:goal
        (and
            (na_paliku k1 z)
            (na_paliku k2 z)
            (na_paliku k3 z)
            (na_paliku k4 z)
            (na_paliku k5 z)
        )
    )
)
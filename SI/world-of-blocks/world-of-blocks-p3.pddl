(define (problem p3)
    (:domain world-of-blocks)
    (:objects a b c d e f)
    (:init
        (clear a)
        (not (on-floor a))
        (on-top a b)
        (not (clear b))
        (on-floor b)
        (clear c)
        (on-floor c)
        (clear d)
        (on-floor d)
        (clear e)
        (on-floor e)
        (clear f)
        (on-floor f)
    )
    (:goal
        (and
            (not (exists (?p) (holding ?p)))
            (exists (?p)
                (and
                    (on-floor ?p)
                    (not (exists (?i)
                        (and
                            (on-floor ?i)
                            (not (= ?i ?p))
                        )
                    ))
                )
            )
        )
    )
)
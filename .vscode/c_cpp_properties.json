{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/ATM_Project/include",
                "/opt/homebrew/include",
                "/opt/homebrew/lib/QtCore.framework/Headers",
                "/opt/homebrew/lib/QtGui.framework/Headers",
                "/opt/homebrew/lib/QtWidgets.framework/Headers",
                "/opt/homebrew/lib/Qt*.framework/Headers"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/opt/homebrew/lib",
                "/Library/Frameworks",
                "/System/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "/opt/homebrew/include",
                    "/opt/homebrew/lib"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": ""
            }
        }
    ],
    "version": 4
}